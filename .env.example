# ============================================================
# MedMitra Environment Configuration Example
# Copy this file to .env and fill in your actual credentials.
# NEVER commit real secrets to source control.
# ============================================================

# MongoDB Database Connection String
MONGODB_URI=mongodb://localhost:27017/medmitra

# Secret key used for signing JWT authentication tokens (Must be strong in production)
JWT_SECRET=change_this_to_a_secure_random_jwt_secret_key_32bytes

# JWT expiration duration (e.g. 1d, 7d, 24h)
JWT_EXPIRES_IN=24h

# Server execution environment (development | test | production)
NODE_ENV=development

# Node Express Backend Server Port
PORT=5000

# CORS Allowed Origin for Frontend
FRONTEND_URL=http://localhost:3000

# FastAPI AI Service Endpoint URL
AI_SERVICE_URL=http://localhost:8000

# Redis Connection Settings (Used for BullMQ Job Queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Hugging Face API Configuration (Phase 3 & Phase 4 Embeddings)
# Used by HuggingFaceASRProvider, HuggingFaceDocumentProvider, and HuggingFaceEmbeddingProvider
HUGGINGFACE_API_TOKEN=your_huggingface_api_token_here
HF_ASR_MODEL=openai/whisper-small
HF_DOC_MODEL=impira/layoutlm-invoices

# ============================================================
# Phase 4 — Knowledge Base, FAISS & LLM Provider Credentials
# ============================================================

# LLM Provider selection: mock | openai | anthropic
# When set to 'mock', system operates offline without requiring live API keys.
LLM_PROVIDER=mock

# OpenAI API Key (Required when LLM_PROVIDER=openai)
# Used by OpenAILLMProvider for structured JSON summary generation.
# NEVER commit real keys.
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (Required when LLM_PROVIDER=anthropic)
# Used by AnthropicLLMProvider for structured Claude summary generation.
# NEVER commit real keys.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Embedding Provider selection: mock | huggingface
EMBEDDING_PROVIDER=mock

# FAISS Vector Index Directory Path
FAISS_INDEX_PATH=knowledge-base/index

# ============================================================
# Phase 2 — Secure Storage Abstraction & AWS S3 Configuration
# ============================================================

# Storage Provider selection: local | gridfs | s3
# When set to 'local' or 'gridfs', system operates locally without AWS credentials.
STORAGE_PROVIDER=local

# AWS S3 Bucket & Credentials (Required when STORAGE_PROVIDER=s3)
AWS_REGION=us-east-1
S3_BUCKET_NAME=medmitra-uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Signed URL Expiration Duration in Seconds (Default: 300 seconds / 5 minutes)
S3_SIGNED_URL_EXPIRES=300

# Maximum Allowed File Upload Size in Bytes (Default: 10MB = 10485760 bytes)
MAX_FILE_SIZE_BYTES=10485760

